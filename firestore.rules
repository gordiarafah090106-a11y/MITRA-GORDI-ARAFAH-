rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Health check / connection test
    match /test/connection {
      allow read: if true;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /profile/{profileId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(profileId)
          && request.resource.data.userId == userId
          && request.resource.data.namaMitra is string;
        allow delete: if isOwner(userId) && isValidId(profileId);
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(transactionId)
          && request.resource.data.userId == userId
          && request.resource.data.bayar is number
          && request.resource.data.laba is number
          && request.resource.data.status in ['Lunas', 'Belum Bayar'];
        allow delete: if isOwner(userId) && isValidId(transactionId);
      }

      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(invoiceId)
          && request.resource.data.userId == userId
          && request.resource.data.total is number
          && request.resource.data.status in ['Lunas', 'Belum'];
        allow delete: if isOwner(userId) && isValidId(invoiceId);
      }

      match /contacts/{contactId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(contactId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(contactId);
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(settingsId)
          && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) && isValidId(settingsId);
      }
    }
  }
}
